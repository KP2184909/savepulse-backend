-- PREPARED ONLY. Run in SavePulse Production after the Render worker route
-- is deployed, its dedicated credential configured, and staging QA accepted.
-- Never paste a token into this file or a cron command.
-- Vault secret savepulse_billing_worker_token must match BILLING_WORKER_KEY
-- in Render. Existing cron/http/Vault must be verified before execution.
-- Use synchronous http: this project's pg_net request queue grants PUBLIC
-- access that postgres could not revoke. Never put credentials in that queue.
do $$
begin
  if not exists(select 1 from vault.decrypted_secrets
    where name='savepulse_billing_worker_token' and decrypted_secret ~ '^[a-f0-9]{64}$') then
    raise exception 'Dedicated worker credential must be configured securely first';
  end if;
end $$;
select cron.schedule('savepulse-billing-webhook-live-worker','*/5 * * * *',$job$
  select private.run_savepulse_billing_worker();
$job$);
-- Define/review private.run_savepulse_billing_worker() with SECURITY INVOKER,
-- no PUBLIC execute, fixed target URL, bounded curl timeout and redacted results
-- before scheduling. No token-bearing function/cron may be publicly callable.
-- Verify HTTP response AND advancing queue worker heartbeat separately.
