//@version=6
indicator("FreightPulse BDI-ZIM Sandbox Telemetry v1.0", overlay = false)
// Transport diagnostics only. NOT a BDI algorithm or SavePulse ZIM adapter.
string SCRIPT = "freightpulse.context.telemetry.v1"
bool enableSend = input.bool(false, "Enable sandbox webhook output", display = display.none)
string token = input.string("", "Dedicated FreightPulse TEST webhook token", display = display.none)
bool isBdi = syminfo.prefix == "INDEX" and syminfo.ticker == "BDI"
bool isZim = syminfo.prefix == "NYSE" and syminfo.ticker == "ZIM"
bool chartOk = timeframe.isdaily and timeframe.multiplier == 1 and chart.is_standard and (isBdi or isZim)
if barstate.isfirst and not chartOk
    runtime.error("Use a standard INDEX:BDI or NYSE:ZIM chart on 1D.")
f_quote(string value) =>
    "\"" + str.replace_all(str.replace_all(str.replace_all(value, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n") + "\""
f_time(int value) =>
    f_quote(str.format_time(value, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC"))
if enableSend and barstate.isrealtime and barstate.isconfirmed and not na(close) and not na(time_close) and str.length(token) >= 24
    string payload = "{\"contractVersion\":\"freightpulse.draft.v2\",\"scriptVersion\":" + f_quote(SCRIPT) + ",\"eventId\":" + f_quote(SCRIPT + ":" + syminfo.ticker + ":" + str.tostring(time)) + ",\"symbol\":" + f_quote(isBdi ? "INDEX:BDI" : "NYSE:ZIM") + ",\"family\":" + f_quote(isBdi ? "bulk" : "context") + ",\"route\":null,\"timeframe\":\"1D\",\"barTime\":" + f_time(time) + ",\"barCloseTime\":" + f_time(time_close) + ",\"barClosed\":true,\"signalStatus\":\"unclear\",\"windowState\":\"inactive\",\"windowDay\":null,\"windowStart\":null,\"sourceUpdatedAt\":null,\"sourceFreshness\":\"unknown\",\"source\":\"TradingView-Pine-telemetry-only\",\"dataMode\":\"test\"}"
    alert("{\"secret_key\":" + f_quote(token) + ",\"payload\":" + payload + "}", alert.freq_once_per_bar_close)
plot(close, "Reference chart close — not a booking quote")
var table panel = table.new(position.top_right, 1, 2)
if barstate.islast
    table.cell(panel, 0, 0, "SANDBOX TELEMETRY ONLY · " + syminfo.ticker, text_color = color.white, bgcolor = color.new(color.black, 15))
    table.cell(panel, 0, 1, isBdi ? "BDI assessment not enabled: rules pending" : "ZIM assessment not enabled: SavePulse source mapping pending", text_color = color.white, bgcolor = color.new(color.black, 15))
